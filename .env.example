# Copy this file to .env (git-ignored) at the repository's top folder and fill
# in what you use. Every setting is optional; blank means "not set". The
# settings are defined in capstone-code/capstone/settings.py. Never commit a key.

# --- memory store ----------------------------------------------------------------
# Neon/Postgres connection string, for --memory runs and the database check.
DATABASE_URL=""
# Free-text recall: semantic (Chroma, falls back to keyword), keyword, or none.
MEMORY_RETRIEVAL_MODE=semantic
# Where the Chroma index lives (default: .chroma at the repository top).
# Leave it commented out for the default: a blank value would mean "here".
# CHROMA_PATH=.chroma
CHROMA_COLLECTION=episodic_memories
# The embedding model: provider/model (NVIDIA only for now) or "local".
# Changing it means `python -m capstone.memory.backfill --rebuild`.
EMBEDDING_MODEL=nvidia/nvidia/nemotron-3-embed-1b

# --- model provider keys (in scope: NVIDIA, Groq, Mistral, Gemini, Cohere, Cloudflare)
# Use exactly these names: the code reads no others (for example not GROQ or
# GOOGLE_GEMINI_API_KEY).
NVIDIA_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Two model routers (added 2026-10-21). A model reference is router/model as
# the router lists it, e.g. requesty/nvidia/nemotron-3-ultra-550b-a55b or
# xkiro/qwen/qwen3.8-max:free. Both also list Anthropic and OpenAI models: never
# use those here (AGENTS.md section 9).
REQUESTY_API_KEY=
XKIRO_API_KEY=
# A third router: 100,000 free tokens a day, for a support agent only.
LLM7_API_KEY=

# --- which model answers which question ------------------------------------------
# "provider/model". Every job uses DEFAULT_MODEL unless its own setting names
# another.
DEFAULT_MODEL=nvidia/nvidia/nemotron-3.5-super-vl-120b-a12b
PLAN_MODEL=
DECIDE_MODEL=
INTERPRET_MODEL=
HYPOTHESIZE_MODEL=
CONCLUDE_MODEL=
JUDGE_MODEL=
LESSON_MODEL=
# Asked when a job's own model gives no answer in time. Blank: no fallback.
# Groq's qwen/qwen3.8-27b answered in under a second on 2026-10-20.
FALLBACK_MODEL=

# --- limits on every model question ----------------------------------------------
# Tokens one reply may use, thinking included.
MODEL_MAX_OUTPUT_TOKENS=16384
# Seconds one request may wait, and one question in all (retries and fallback included).
MODEL_REQUEST_SECONDS=45
MODEL_QUESTION_SECONDS=90
# How many more times an unreachable model is asked (after 2, 4, 8 s) before moving on.
MODEL_RETRIES=3
